rules_version = '2';
// Paste into the Firebase console: Firestore Database > Rules > Publish (docs/reference/safari.md).
// saves/<uid>: the cloud save (js/cloud.js). safariBoard/<day>_<uid>: the Safari Zone's daily leaderboard
// (js/leaderboard.js; its bounds match LIMITS in js/data/leaderboard.js): anyone reads, a signed-in player posts
// their own entry for a day once, and nobody edits or deletes one. towerBoard/<week>_<uid>: the Sky Pillar's, the same
// way once a week. arcadeBoard/<week>_<game>_<uid>: the home arcade's weekly bests, raised only by a higher score.
// trainers/<uid> and codes/<CODE>: the Trainers app's public pages and friend codes (js/trainers.js); plaza/<uid> the
// Trainer Plaza's trainers on lately, adds/<to>_<from> the note that pops up for someone you added, and graves/<uid> a
// trainer's last lost runs (friends' tombstones, js/graves.js).
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function isDay(day) {
      return day is string && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    // the entry's day is yesterday, today or tomorrow (UTC) when it's posted
    function nearToday(day) {
      let p = day.split('-');
      let start = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return request.time >= start - duration.value(1, 'd') && request.time < start + duration.value(2, 'd');
    }
    function inRange(n, lo, hi) {
      return n is int && n >= lo && n <= hi;
    }
    function validEntry(id, d) {
      return d.keys().hasOnly(['day', 'uid', 'name', 'starter', 'won', 'area', 'bosses', 'turns', 'time', 'caught', 'at', 'shinies'])
        && d.keys().hasAll(['day', 'uid', 'name', 'starter', 'won', 'area', 'bosses', 'turns', 'time', 'caught', 'at'])
        && d.uid == request.auth.uid
        && isDay(d.day) && id == d.day + '_' + request.auth.uid && nearToday(d.day)
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.starter is string && d.starter.size() >= 1 && d.starter.size() <= 32
        && d.won is bool
        && inRange(d.area, 1, 3) && inRange(d.bosses, 0, 3) && d.won == (d.bosses == 3)
        && inRange(d.turns, 0, 3000) && inRange(d.time, 0, 604800) && inRange(d.caught, 0, 300)
        && (!('shinies' in d) || inRange(d.shinies, 1, 300))
        && d.at == request.time;
    }

    match /safariBoard/{id} {
      allow read: if true;
      allow create: if request.auth != null && validEntry(id, request.resource.data);
      allow update, delete: if false;
    }

    // towerBoard/<week>_<uid>: the Sky Pillar's weekly leaderboard (js/data/tower.js; bounds match TOWER_LIMITS in
    // js/data/leaderboard.js). The week is its Monday; it's posted that week or the day after it ends.
    function nearWeek(week) {
      let p = week.split('-');
      let start = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return request.time >= start && request.time < start + duration.value(8, 'd');
    }
    function validClimb(id, d) {
      return d.keys().hasOnly(['week', 'uid', 'name', 'starter', 'floor', 'turns', 'time', 'at', 'augments'])
        && d.keys().hasAll(['week', 'uid', 'name', 'starter', 'floor', 'turns', 'time', 'at'])
        && d.uid == request.auth.uid
        && isDay(d.week) && id == d.week + '_' + request.auth.uid && nearWeek(d.week)
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.starter is string && d.starter.size() >= 1 && d.starter.size() <= 32
        && inRange(d.floor, 0, 999) && inRange(d.turns, 0, 60000) && inRange(d.time, 0, 691200)
        && (!('augments' in d) || (d.augments is list && d.augments.size() <= 10))
        && d.at == request.time;
    }

    match /towerBoard/{id} {
      allow read: if true;
      allow create: if request.auth != null && validClimb(id, request.resource.data);
      allow update, delete: if false;
    }

    // arcadeBoard/<week>_<game>_<uid>: the home arcade's weekly best scores (ARCADE_GAMES / ARCADE_SCORE in
    // js/data/leaderboard.js). A player's own entry may be raised that week, never lowered or deleted.
    function validArcade(id, d) {
      return d.keys().hasOnly(['week', 'game', 'uid', 'name', 'starter', 'score', 'at'])
        && d.keys().hasAll(['week', 'game', 'uid', 'name', 'starter', 'score', 'at'])
        && d.uid == request.auth.uid
        && isDay(d.week) && nearWeek(d.week)
        && d.game in ['runner', 'flap', 'stacker', 'puzzle', 'invaders', 'snake', 'bubble']
        && id == d.week + '_' + d.game + '_' + request.auth.uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.starter is string && d.starter.size() >= 1 && d.starter.size() <= 32
        && inRange(d.score, 1, 9999999)
        && d.at == request.time;
    }

    match /arcadeBoard/{id} {
      allow read: if true;
      allow create: if request.auth != null && validArcade(id, request.resource.data);
      allow update: if request.auth != null && validArcade(id, request.resource.data)
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // codes/<CODE>: a friend code, 8 letters with no look-alikes (CODE_LETTERS in js/data/trainers.js), claimed once by
    // its owner and never changed, so a clash just rolls another. Looked up one at a time, never listed.
    function isCode(c) {
      return c is string && c.matches('[A-HJKMNP-Z]{8}');
    }
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && isCode(code)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if false;
    }

    // trainers/<uid>: a trainer's public page (bounds match checkTrainer() in js/data/trainers.js). Signed-in players
    // read it one at a time; only its owner writes it, under a code they own. `base` is their Secret Base as JSON.
    function validCard(c) {
      return c is map
        && c.keys().hasOnly(['tier', 'badges', 'wins', 'dex', 'dexOf', 'safari', 'safariOf', 'stars', 'time', 'partner', 'rank', 'top', 'fave', 'pillar'])
        && c.tier in ['green', 'bronze', 'silver', 'gold', 'violet']
        && c.badges is list && c.badges.size() <= 100
        && inRange(c.wins, 0, 10000000) && inRange(c.dex, 0, 9999) && inRange(c.dexOf, 0, 9999)
        && inRange(c.safari, 0, 9999) && inRange(c.safariOf, 0, 9999) && inRange(c.stars, 0, 99)
        && inRange(c.time, 0, 10000000) && c.partner is string && c.partner.size() <= 64
        && (!('rank' in c) || inRange(c.rank, -1, 20)) && (!('top' in c) || inRange(c.top, -1, 20))
        && (!('fave' in c) || (c.fave is string && c.fave.size() <= 64)) && (!('pillar' in c) || inRange(c.pillar, 0, 999));
    }
    function validTrainer(d) {
      return d.keys().hasOnly(['code', 'name', 'card', 'buddy', 'base', 'at'])
        && d.keys().hasAll(['code', 'name', 'card', 'buddy', 'at'])
        && isCode(d.code)
        && get(/databases/$(database)/documents/codes/$(d.code)).data.uid == request.auth.uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && validCard(d.card)
        && d.buddy is string && d.buddy.size() <= 64
        && (!('base' in d) || (d.base is string && d.base.size() <= 600000))
        && d.at == request.time;
    }
    match /trainers/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && validTrainer(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
    }

    // a trainer in a line (blurbDoc() in js/data/trainers.js), for the Plaza and the notes
    function validBlurb(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.buddy is string && d.buddy.size() <= 64 && d.partner is string && d.partner.size() <= 64
        && d.tier in ['green', 'bronze', 'silver', 'gold', 'violet']
        && inRange(d.badges, 0, 999) && inRange(d.wins, 0, 10000000);
    }

    // plaza/<uid>: the Trainer Plaza. Signed-in players list it (newest first); each writes or takes down only their own.
    match /plaza/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'buddy', 'partner', 'tier', 'badges', 'wins', 'at'])
        && request.resource.data.keys().hasAll(['name', 'buddy', 'partner', 'tier', 'badges', 'wins', 'at'])
        && validBlurb(request.resource.data) && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // graves/<uid>: a trainer's last 5 lost runs (each a JSON string, packFall() in js/data/graves.js) with their name and
    // buddy, for friends' tombstones on the map and buddies in the Trainer Plaza. Read one at a time; only its owner writes it.
    function fallOk(f, i) {
      return f.size() <= i || (f[i] is string && f[i].size() <= 4000);
    }
    function validGraves(d) {
      return d.keys().hasOnly(['name', 'buddy', 'tier', 'falls', 'at'])
        && d.keys().hasAll(['name', 'buddy', 'tier', 'falls', 'at'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.buddy is string && d.buddy.size() <= 64
        && d.tier in ['green', 'bronze', 'silver', 'gold', 'violet']
        && d.falls is list && d.falls.size() <= 5
        && fallOk(d.falls, 0) && fallOk(d.falls, 1) && fallOk(d.falls, 2) && fallOk(d.falls, 3) && fallOk(d.falls, 4)
        && d.at == request.time;
    }
    match /graves/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && validGraves(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
    }

    // adds/<to>_<from>: left by `from` on adding `to`. Only `to` reads them (a query on to == you), and only marks one
    // seen; `from` writes it as themselves (re-adding raises it again); either may take it down.
    function validAdd(id, d) {
      return d.keys().hasOnly(['from', 'to', 'name', 'buddy', 'partner', 'tier', 'badges', 'wins', 'seen', 'at'])
        && d.keys().hasAll(['from', 'to', 'name', 'buddy', 'partner', 'tier', 'badges', 'wins', 'seen', 'at'])
        && d.from == request.auth.uid && d.to is string && d.to.size() >= 1 && d.to.size() <= 128 && d.to != d.from
        && id == d.to + '_' + d.from && validBlurb(d) && d.seen == false && d.at == request.time;
    }
    match /adds/{id} {
      allow read: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null && validAdd(id, request.resource.data);
      allow update: if request.auth != null && (
        (resource.data.from == request.auth.uid && validAdd(id, request.resource.data))
        || (resource.data.to == request.auth.uid && request.resource.data.seen == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])));
      allow delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
  }
}
